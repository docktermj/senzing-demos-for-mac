# Copy to .env and fill in. Never commit .env.
# Target: local (this workstation). Placeholder values only.

# Senzing database connection string, used by src/scripts/senzing-env.sh to build the engine
# configuration when SENZING_ENGINE_CONFIGURATION_JSON is not set.
#   SQLite (development):  sqlite3://na:na@/absolute/path/to/project/database/G2C.db
#   PostgreSQL:            postgresql://user:password@host:5432:g2
DATABASE_URL=sqlite3://na:na@/absolute/path/to/project/database/G2C.db

# Path to your Senzing license (.lic) file. src/scripts/senzing-env.sh writes it into the engine
# configuration as PIPELINE.LICENSEFILE. Leave empty to run on the built-in evaluation license
# (500-record limit).
SENZING_LICENSE_FILE=

# Or set the full engine configuration yourself (it takes precedence over the two values above).
# License alternatives inside PIPELINE: "LICENSEFILE": "/path/to/g2.lic"  or
#                                       "LICENSESTRINGBASE64": "<base64 license string>"
# SENZING_ENGINE_CONFIGURATION_JSON={"PIPELINE": {"CONFIGPATH": "/opt/homebrew/opt/senzing/er/etc", "RESOURCEPATH": "/opt/homebrew/opt/senzing/er/resources", "SUPPORTPATH": "/opt/homebrew/opt/senzing/data", "LICENSESTRINGBASE64": "<base64 license string>"}, "SQL": {"CONNECTION": "postgresql://user:password@host:5432:g2"}}

LOG_LEVEL=INFO
