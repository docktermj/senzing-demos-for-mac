# Target: local / on-premises.
# Replace with the complete engine configuration required by your installation.
# This placeholder demonstrates the supported PIPELINE license-file setting.
SENZING_ENGINE_CONFIGURATION_JSON='{"PIPELINE":{"LICENSEFILE":"./licenses/g2.lic"}}'
# Inline alternative: {"PIPELINE":{"LICENSESTRINGBASE64":"<BASE64_LICENSE_PLACEHOLDER>"}}

# Keep the license outside version control. Ensure this path matches PIPELINE.LICENSEFILE above.
# For on-premises deployment, inject the license path through your approved secret-management process.
SENZING_LICENSE_FILE=./licenses/g2.lic

# Local SQLite location; the current Java code uses the engine configuration for database setup.
# Replace this with the on-premises database endpoint when moving beyond local development.
DATABASE_URL=jdbc:sqlite:database/G2C.db
LOG_LEVEL=INFO

# Optional override; on macOS, the environment script can discover this from Homebrew.
SENZING_ROOT=
