# Target: local / on-premises (single host, SQLite) — move to PostgreSQL before production volumes.
# Copy to .env (never commit .env) and fill in real values from your secret store.

# Engine configuration (JSON, one line). PIPELINE paths shown for the macOS Homebrew SDK;
# on Linux use /etc/opt/senzing, /opt/senzing/er/resources and /opt/senzing/data.
# License: add ONE of these inside PIPELINE (both documented by Senzing):
#   "LICENSEFILE": "/secure/path/g2.lic"            (path to a .lic file)
#   "LICENSESTRINGBASE64": "<base64 license string>" (inline, preferred for containers)
SENZING_ENGINE_CONFIGURATION_JSON='{"PIPELINE":{"CONFIGPATH":"/opt/homebrew/opt/senzing/er/etc","RESOURCEPATH":"/opt/homebrew/opt/senzing/er/resources","SUPPORTPATH":"/opt/homebrew/opt/senzing/data","LICENSEFILE":"/secure/path/g2.lic"},"SQL":{"CONNECTION":"sqlite3://na:na@/absolute/path/to/database/G2C.db"}}'

# Path to the license file, for deployment tooling that mounts it. The engine itself reads the
# license from PIPELINE above; this variable's name could not be confirmed against Senzing's
# documentation at generation time, so keep PIPELINE as the source of truth.
SENZING_LICENSE_FILE=/secure/path/g2.lic

# Database URL for the production datastore (PostgreSQL recommended at production scale).
# Senzing's connection-string form for PostgreSQL: postgresql://user:password@host:5432:g2
DATABASE_URL=postgresql://senzing_user:CHANGE_ME@db.example.internal:5432:g2

LOG_LEVEL=INFO
