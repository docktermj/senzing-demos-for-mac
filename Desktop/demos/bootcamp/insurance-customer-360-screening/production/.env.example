# Target: local / on-premises
# Copy to .env and fill in. Never commit .env.

# Senzing engine settings (JSON). The env script reads config/engine_config.json when this is unset.
# The license goes INSIDE this JSON, in the PIPELINE section, as either:
#   "LICENSEFILE": "/path/to/g2.lic"             (path to a .lic file)
#   "LICENSESTRINGBASE64": "<base64 license key>"  (inline; preferred for containers and automation)
SENZING_ENGINE_CONFIGURATION_JSON='{"PIPELINE":{"CONFIGPATH":"/opt/senzing/er/etc","RESOURCEPATH":"/opt/senzing/er/resources","SUPPORTPATH":"/opt/senzing/data","LICENSEFILE":"/app/licenses/g2.lic"},"SQL":{"CONNECTION":"sqlite3://na:na@/app/database/G2C.db"}}'

# Path to the production license file, if you keep it outside the JSON above.
# NOTE: the Senzing engine reads the license from PIPELINE.LICENSEFILE or LICENSESTRINGBASE64;
# this variable is for your own deployment scripts that template that value.
SENZING_LICENSE_FILE=/app/licenses/g2.lic

# Database location (SQLite file today; a PostgreSQL URL if you move to PostgreSQL).
DATABASE_URL=sqlite3://na:na@/app/database/G2C.db

LOG_LEVEL=INFO
