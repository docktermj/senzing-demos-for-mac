# Target: local or on-premises (not stated)
# Copy to .env and fill in real values. Never commit .env.

# Senzing engine configuration (JSON). The license goes in its PIPELINE section:
#   "LICENSESTRINGBASE64": "<base64 license key>"   (inline key, preferred)
#   or "LICENSEFILE": "/path/to/g2.lic"              (path to an existing .lic file)
SENZING_ENGINE_CONFIGURATION_JSON='{"PIPELINE":{"CONFIGPATH":"/etc/opt/senzing","RESOURCEPATH":"/opt/senzing/er/resources","SUPPORTPATH":"/opt/senzing/data"},"SQL":{"CONNECTION":"sqlite3://na:na@/app/database/G2C.db"}}'

# Database connection (SQLite here; for PostgreSQL use postgresql://user:password@host:5432/senzing)
DATABASE_URL=sqlite3://na:na@/app/database/G2C.db

LOG_LEVEL=INFO
