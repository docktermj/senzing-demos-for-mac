# Target: local / on-premises. Copy to .env and replace placeholders before use.
SENZING_ENGINE_CONFIGURATION_JSON='{"PIPELINE":{},"SQL":{"CONNECTION":"<configure-for-your-installation>"}}'
SENZING_LICENSE_FILE=./licenses/g2.lic
DATABASE_URL=sqlite:///./database/G2C.db
LOG_LEVEL=INFO

# SENZING_LICENSE_FILE is a convenience path; the launcher does not map it automatically.
# Configure PIPELINE.LICENSEFILE in the engine JSON, or use PIPELINE.LICENSESTRINGBASE64
# when supplying an encoded license string.
